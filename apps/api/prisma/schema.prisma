// CodeSphere Business Operating System — Database Schema
// This schema is the architectural backbone: every module in the
// original brief has a corresponding model (or explicit future-hook
// field) so new modules can be built on top of this data model
// without a schema rewrite. See README.md for a module-by-module
// implementation status (implemented vs. scaffolded vs. planned).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------
// Enums
// ---------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  SALES
  BUSINESS_DEV
  PROJECT_MANAGER
  DEVELOPER
  DESIGNER
  QA
  FINANCE
  SUPPORT
  CLIENT
  GUEST
}

enum PipelineStage {
  NEW_LEAD
  QUALIFIED
  DISCOVERY_CALL
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectHealth {
  GREEN
  YELLOW
  RED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  BLOCKED
}

enum DocumentType {
  CONTRACT
  NDA
  PROPOSAL
  QUOTATION
  INVOICE
  DESIGN
  REQUIREMENT
  MEETING_NOTES
  TECHNICAL_DOC
  OTHER
}

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CLIENT
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  NEW_ENQUIRY
  PROPOSAL_ACCEPTED
  INVOICE_OVERDUE
  PROJECT_DELAYED
  MEETING_REMINDER
  SUPPORT_TICKET
  CLIENT_MESSAGE
  TASK_ASSIGNED
  SYSTEM
}

enum EmailStatus {
  DRAFT
  SENT
  FAILED
}

enum EmailTemplateType {
  THANK_YOU
  PROPOSAL
  MEETING_INVITE
  QUOTATION_DELIVERY
  FOLLOW_UP
  REMINDER
  CONTRACT_REQUEST
  PROJECT_UPDATE
  INVOICE_REMINDER
  COMPLETION
  SUPPORT_RESPONSE
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// ---------------------------------------------------------------
// Identity & Access
// ---------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(GUEST)
  isActive     Boolean  @default(true)
  clientId     String?  // set when role = CLIENT, links to their Client record
  client       Client?  @relation(fields: [clientId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens    RefreshToken[]
  assignedLeads     Lead[]           @relation("AssignedSalesperson")
  assignedTasks     Task[]           @relation("TaskAssignee")
  assignedTickets   SupportTicket[]  @relation("TicketAssignee")
  notifications     Notification[]
  auditLogs         AuditLog[]
  uploadedDocuments Document[]       @relation("DocumentUploader")
  sentEmails        EmailLog[]       @relation("EmailSender")

  @@index([role])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------
// Module 1 & 2 — Smart CRM + Lead Analyzer
// ---------------------------------------------------------------

model Lead {
  id       String @id @default(cuid())
  leadCode String @unique @default(cuid()) // human-shareable reference, e.g. for email threads

  // Captured from the website enquiry form (or manual entry)
  name                String
  company              String?
  email                String
  phone                String?
  country              String?
  industry             String?
  budgetRange          String?
  timeline             String?
  projectType          String?
  servicesInterested   String[] @default([])
  requirements         String?  @db.Text
  referralSource       String?
  landingPage          String?
  campaignSource       String?
  ipAddress            String? // optional, only stored if explicitly enabled — see privacy note in README
  submittedAt          DateTime @default(now())

  // Assigned by the system on intake (Module 1)
  leadScore          Int            @default(0)
  priority           Priority       @default(LOW)
  estimatedRevenue   Decimal?       @db.Decimal(12, 2)
  assignedToId        String?
  assignedTo          User?          @relation("AssignedSalesperson", fields: [assignedToId], references: [id])
  pipelineStage       PipelineStage  @default(NEW_LEAD)
  expectedCloseDate   DateTime?

  // Module 2 — AI Lead Analyzer output (nullable until analysis runs;
  // populated by a heuristic engine by default, upgradeable to a real
  // LLM call — see services/leadAnalyzer.ts)
  complexity            String?
  budgetQuality          String?
  urgency                String?
  clientIntent           String?
  businessValue           String?
  technologyRequirements  String[] @default([])
  estimatedDevWeeks      Int?
  suggestedTeam           String[] @default([])
  suggestedNextAction     String?
  riskLevel                RiskLevel?
  confidenceScore          Float?   // 0.0–1.0

  attachments Document[]
  emailLogs   EmailLog[]
  meetings    Meeting[]
  activityLogs AuditLog[]
  client      Client?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pipelineStage])
  @@index([assignedToId])
  @@index([email])
}

// ---------------------------------------------------------------
// Module 5 & 6 — Client Management + Client Portal
// ---------------------------------------------------------------

model Client {
  id       String  @id @default(cuid())
  leadId   String? @unique
  lead     Lead?   @relation(fields: [leadId], references: [id])
  name     String
  company  String?
  email    String  @unique
  phone    String?
  industry String?
  country  String?

  portalUsers User[]

  projects      Project[]
  proposals     Proposal[]
  quotations    Quotation[]
  invoices      Invoice[]
  documents     Document[]
  supportTickets SupportTicket[]
  meetings      Meeting[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------
// Module 4 — Sales Pipeline is represented by Lead.pipelineStage
// above (Kanban stages as an enum on the Lead record itself, rather
// than a separate join table) — simplest correct model for a single
// linear pipeline; a future multi-pipeline feature would add a
// Pipeline model and move pipelineStage onto a join table.
// ---------------------------------------------------------------

// ---------------------------------------------------------------
// Module 7 — Project Management
// ---------------------------------------------------------------

model Project {
  id          String        @id @default(cuid())
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id])
  name        String
  description String?       @db.Text
  status      ProjectStatus @default(PLANNING)
  health      ProjectHealth @default(GREEN)
  startDate   DateTime?
  endDate     DateTime?

  tasks      Task[]
  milestones Milestone[]
  documents  Document[]
  invoices   Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

model Task {
  id          String     @id @default(cuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?    @db.Text
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  assigneeId  String?
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  dueDate     DateTime?
  estimatedHours Float?
  loggedHours    Float?   @default(0) // time-tracking accumulator

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([assigneeId])
}

model Milestone {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  dueDate   DateTime?
  completed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([projectId])
}

// ---------------------------------------------------------------
// Module 8 & 9 — Proposal & Quotation Generators
// ---------------------------------------------------------------

model Proposal {
  id        String         @id @default(cuid())
  leadId    String?
  clientId  String?
  client    Client?        @relation(fields: [clientId], references: [id])
  title     String
  sections  Json           // { coverPage, companyProfile, scope, objectives, deliverables, timeline, milestones, pricing, terms }
  status    ProposalStatus @default(DRAFT)
  pdfUrl    String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([clientId])
}

model Quotation {
  id            String          @id @default(cuid())
  leadId        String?
  clientId      String?
  client        Client?         @relation(fields: [clientId], references: [id])
  items         Json            // [{ description, quantity, unitPrice }]
  taxPercent    Float           @default(0)
  discountPercent Float         @default(0)
  total         Decimal         @db.Decimal(12, 2)
  vatNumber     String?
  qrCodeData    String?
  status        QuotationStatus @default(DRAFT)
  pdfUrl        String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([clientId])
}

// ---------------------------------------------------------------
// Module 10 — Invoice Management
// ---------------------------------------------------------------

model Invoice {
  id            String        @id @default(cuid())
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id])
  projectId     String?
  project       Project?      @relation(fields: [projectId], references: [id])
  items         Json
  total         Decimal       @db.Decimal(12, 2)
  status        InvoiceStatus @default(DRAFT)
  dueDate       DateTime?
  paidAt        DateTime?
  isRecurring   Boolean       @default(false) // future-ready flag; recurring billing engine not yet implemented
  recurrenceRule String?      // future-ready (e.g. RRULE string), unused until recurring billing ships

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([status])
}

// ---------------------------------------------------------------
// Module 11 — Document Management
// ---------------------------------------------------------------

model Document {
  id           String       @id @default(cuid())
  type         DocumentType
  fileName     String
  fileUrl      String       // abstracted storage path — see services/storage.ts
  version      Int          @default(1)
  clientId     String?
  client       Client?      @relation(fields: [clientId], references: [id])
  projectId    String?
  project      Project?     @relation(fields: [projectId], references: [id])
  leadId       String?
  lead         Lead?        @relation(fields: [leadId], references: [id])
  uploadedById String?
  uploadedBy   User?        @relation("DocumentUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime     @default(now())

  @@index([clientId])
  @@index([projectId])
}

// ---------------------------------------------------------------
// Module 13 — Communication Center
// ---------------------------------------------------------------

model Meeting {
  id          String        @id @default(cuid())
  leadId      String?
  lead        Lead?         @relation(fields: [leadId], references: [id])
  clientId    String?
  client      Client?       @relation(fields: [clientId], references: [id])
  scheduledAt DateTime
  attendees   String[]      @default([])
  notes       String?       @db.Text
  status      MeetingStatus @default(SCHEDULED)
  createdAt   DateTime      @default(now())

  @@index([leadId])
  @@index([clientId])
}

model EmailLog {
  id           String            @id @default(cuid())
  toEmail      String
  subject      String
  body         String            @db.Text
  templateType EmailTemplateType
  status       EmailStatus       @default(DRAFT)
  leadId       String?
  lead         Lead?             @relation(fields: [leadId], references: [id])
  sentById     String?
  sentBy       User?             @relation("EmailSender", fields: [sentById], references: [id])
  sentAt       DateTime?
  createdAt    DateTime          @default(now())

  @@index([leadId])
}

// Module 6/13 — Support tickets (client portal + support team)
model SupportTicket {
  id          String         @id @default(cuid())
  clientId    String
  client      Client         @relation(fields: [clientId], references: [id])
  subject     String
  description String         @db.Text
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  assignedToId String?
  assignedTo   User?          @relation("TicketAssignee", fields: [assignedToId], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([clientId])
  @@index([status])
}

// ---------------------------------------------------------------
// Module 14 — Notification Center
// ---------------------------------------------------------------

model Notification {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             NotificationType
  title            String
  message          String
  isRead           Boolean          @default(false)
  relatedEntityType String?
  relatedEntityId   String?
  createdAt        DateTime         @default(now())

  @@index([userId, isRead])
}

// ---------------------------------------------------------------
// Module 16 — Admin Panel: Audit Logs
// ---------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  leadId     String?
  lead       Lead?    @relation(fields: [leadId], references: [id])
  action     String   // e.g. "lead.created", "lead.stage_changed", "user.login"
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------
// Module 16 — Admin Panel: configurable lookups (Services,
// Industries, Website Forms) so these don't need to be hardcoded
// and can be managed from the admin panel once that UI is built.
// ---------------------------------------------------------------

model ServiceOffering {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model IndustryOption {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}
